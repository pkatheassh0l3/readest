<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        A partir de Android 11 (API 30) una app no puede ni comprobar si otra
        está instalada si no la declara aquí ("package visibility"). Sin esto,
        getLaunchIntentForPackage("com.tailscale.ipn") devuelve null AUNQUE
        Tailscale esté instalada y funcionando, y la app diría en falso que no
        la encuentra. Ya nos pasó en NasConnect.
    -->
    <queries>
        <package android:name="com.tailscale.ipn" />
    </queries>

</manifest>
